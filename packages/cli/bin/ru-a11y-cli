#!/usr/bin/env node

'use strict';

 const { runCli } = require('../dist/cli.js');

runCli(process.argv.slice(2))
  .then((code) => {
    process.exit(code);
  })
  .catch((error) => {
    const message = error instanceof Error ? error.message : 'Внутренняя ошибка CLI.';
    process.stderr.write(`Ошибка: ${message}\n`);
    process.exit(2);
  });
