{
  "name": "ru-a11y-toolkit-cli",
  "version": "2.1.0",
  "description": "CLI-аудит веб-доступности по ГОСТ и Постановлению №102 на базе Puppeteer + axe-core.",
  "main": "dist/cli.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ru-a11y": "bin/ru-a11y",
    "ru-a11y-cli": "bin/ru-a11y-cli"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "prebuild": "npm run build -w ru-a11y-toolkit-core",
    "build": "tsup",
    "dev": "tsup --watch",
    "pretest": "npm run build -w ru-a11y-toolkit-core",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "cli",
    "ГОСТ",
    "доступность",
    "puppeteer",
    "axe-core",
    "ru-a11y"
  ],
  "author": {
    "name": "biondohod",
    "url": "https://github.com/biondohod"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/biondohod/ru-a11y.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/biondohod/ru-a11y/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/biondohod/ru-a11y/issues"
  },
  "dependencies": {
    "axe-core": "^4.10.0",
    "eslint": "^9.39.1",
    "puppeteer": "^24.2.1",
    "ru-a11y-toolkit-core": "1.3.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.9",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.6",
    "typescript": "^5.8.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ]
  }
}
