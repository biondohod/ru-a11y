{
  "name": "ru-a11y-toolkit-core",
  "version": "1.3.0",
  "description": "Единое ядро правил, переводов и нормативных ссылок ru-a11y-toolkit.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "ГОСТ",
    "доступность",
    "wcag",
    "ru-a11y"
  ],
  "author": {
    "name": "biondohod",
    "url": "https://github.com/biondohod"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/biondohod/ru-a11y.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/biondohod/ru-a11y/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/biondohod/ru-a11y/issues"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.6",
    "typescript": "^5.8.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ]
  }
}
