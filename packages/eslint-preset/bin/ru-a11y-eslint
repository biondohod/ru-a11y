#!/usr/bin/env node
'use strict';

const { spawn } = require('node:child_process');
const { existsSync, readFileSync } = require('node:fs');
const { createRequire } = require('node:module');
const { dirname, join } = require('node:path');

function hasExplicitFormatter(args) {
  return args.includes('-f') || args.includes('--format');
}

function hasExplicitConfig(args) {
  return args.includes('-c') || args.includes('--config') || args.includes('--no-config-lookup');
}

function resolveProjectConfig() {
  const candidates = [
    'eslint.ru-a11y.config.mjs',
    'eslint.ru-a11y.config.js',
    'eslint.ru-a11y.config.cjs',
  ];

  return candidates.map((candidate) => join(process.cwd(), candidate)).find((candidate) => existsSync(candidate));
}

function resolveEslintBin() {
  const localRequire = createRequire(`${process.cwd()}/package.json`);
  const eslintPackageJsonPath = localRequire.resolve('eslint/package.json');
  const eslintPackageJson = JSON.parse(readFileSync(eslintPackageJsonPath, 'utf-8'));
  const eslintBinRelativePath =
    typeof eslintPackageJson.bin === 'string'
      ? eslintPackageJson.bin
      : eslintPackageJson.bin?.eslint;

  if (!eslintBinRelativePath) {
    throw new Error('Не удалось определить путь к CLI-бинарю eslint из package.json.');
  }

  return join(dirname(eslintPackageJsonPath), eslintBinRelativePath);
}

function resolveFormatterPath() {
  return join(__dirname, '..', 'formatter-pretty.js');
}

function main() {
  const args = process.argv.slice(2);
  const formatterPath = resolveFormatterPath();
  const projectConfig = hasExplicitConfig(args) ? undefined : resolveProjectConfig();
  const configArgs = projectConfig ? ['--config', projectConfig] : [];
  const formatterArgs = hasExplicitFormatter(args)
    ? [...configArgs, ...args]
    : ['-f', formatterPath, ...configArgs, ...args];

  let eslintBin;

  try {
    eslintBin = resolveEslintBin();
  } catch (error) {
    const message = error instanceof Error ? error.message : 'Не удалось найти eslint.';
    process.stderr.write(`Ошибка: ${message}\n`);
    process.stderr.write('Убедитесь, что `eslint` установлен в проекте как dependency или devDependency.\n');
    process.exit(2);
    return;
  }

  const child = spawn(process.execPath, [eslintBin, ...formatterArgs], {
    stdio: 'inherit',
    env: {
      ...process.env,
      ...(projectConfig ? { ESLINT_USE_FLAT_CONFIG: 'true' } : null),
    },
  });

  child.on('exit', (code, signal) => {
    if (signal) {
      process.kill(process.pid, signal);
      return;
    }

    process.exit(code ?? 1);
  });
}

main();
