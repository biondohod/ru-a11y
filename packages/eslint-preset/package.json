{
  "name": "ru-a11y-toolkit-eslint",
  "version": "2.0.2",
  "description": "ESLint-плагин для проверки веб-доступности согласно ГОСТ Р 52872-2019 и Постановлению Правительства РФ №102. Часть ru-a11y-toolkit.",
  "main": "index.js",
  "bin": {
    "ru-a11y-eslint": "bin/ru-a11y-eslint"
  },
  "exports": {
    ".": "./index.js",
    "./formatter": "./formatter-pretty.js",
    "./recommended": "./configs/recommended.js",
    "./gost-aa": "./configs/gost-aa.js",
    "./strict": "./configs/strict.js"
  },
  "scripts": {
    "pretest": "npm run build -w ru-a11y-toolkit-core",
    "test": "jest"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "accessibility",
    "a11y",
    "ГОСТ",
    "доступность",
    "React",
    "jsx-a11y",
    "russia",
    "ru-a11y",
    "wcag"
  ],
  "author": {
    "name": "biondohod",
    "url": "https://github.com/biondohod"
  },
  "license": "MIT",
  "dependencies": {
    "eslint-plugin-jsx-a11y": "^6.0.0",
    "ru-a11y-toolkit-core": "1.3.1"
  },
  "peerDependencies": {
    "eslint": "^8.57.0 || ^9.0.0 || ^10.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/eslint-parser": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "babel-jest": "^29.7.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "files": [
    "index.js",
    "formatter.js",
    "formatter-pretty.js",
    "bin/",
    "configs/",
    "rules/",
    "messages.js",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/biondohod/ru-a11y.git",
    "directory": "packages/eslint-preset"
  },
  "homepage": "https://github.com/biondohod/ru-a11y/tree/master/packages/eslint-preset#readme",
  "bugs": {
    "url": "https://github.com/biondohod/ru-a11y/issues"
  }
}
