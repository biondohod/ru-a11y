{
  "name": "ru-a11y-toolkit-eslint",
  "version": "1.0.0",
  "description": "ESLint-плагин для проверки веб-доступности согласно ГОСТ Р 52872-2019 и Постановлению Правительства РФ №102. Часть ru-a11y-toolkit.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./recommended": "./configs/recommended.js",
    "./gost-aa": "./configs/gost-aa.js",
    "./strict": "./configs/strict.js"
  },
  "scripts": {
    "test": "jest"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "accessibility",
    "a11y",
    "ГОСТ",
    "доступность",
    "React",
    "jsx-a11y",
    "russia",
    "ru-a11y",
    "wcag"
  ],
  "author": {
    "name": "biondohod",
    "url": "https://github.com/biondohod"
  },
  "license": "MIT",
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0",
    "eslint-plugin-jsx-a11y": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-jsx-a11y": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/eslint-parser": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "babel-jest": "^29.7.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "files": [
    "index.js",
    "configs/",
    "rules/",
    "messages.js",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/biondohod/ru-a11y.git",
    "directory": "packages/eslint-preset"
  },
  "homepage": "https://github.com/biondohod/ru-a11y/tree/main/packages/eslint-preset#readme",
  "bugs": {
    "url": "https://github.com/biondohod/ru-a11y/issues"
  }
}
