{
  "name": "ru-a11y-toolkit",
  "version": "2.2.0",
  "description": "Accessibility toolkit for React/JS apps aligned with Russian regulations (GOST R 52872-2019, Government Decree No. 102): ESLint plugin, runtime overlay, CLI auditor and a visually impaired mode.",
  "main": "index.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "ru-a11y-toolkit-cli": "2.1.0",
    "ru-a11y-toolkit-core": "1.4.0",
    "ru-a11y-toolkit-eslint": "2.1.0",
    "ru-a11y-toolkit-overlay": "2.1.0",
    "ru-a11y-toolkit-visually-impaired": "2.1.0"
  },
  "peerDependencies": {
    "eslint": "^8.57.0 || ^9.0.0 || ^10.0.0"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "eslint",
    "eslint-plugin",
    "ГОСТ",
    "доступность",
    "React",
    "JSX",
    "wcag",
    "russia",
    "ru-a11y"
  ],
  "author": {
    "name": "biondohod",
    "url": "https://github.com/biondohod"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/biondohod/ru-a11y.git"
  },
  "homepage": "https://github.com/biondohod/ru-a11y#readme",
  "bugs": {
    "url": "https://github.com/biondohod/ru-a11y/issues"
  },
  "files": [
    "index.js",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": ">=22"
  }
}
