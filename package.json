{
  "name": "ru-a11y",
  "version": "0.1.0",
  "private": true,
  "description": "Монорепозиторий toolkit для автоматизированной веб-доступности React/JS-приложений под российские нормативы",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "jest --passWithNoTests",
    "test:all": "npm run test --workspaces",
    "lint": "eslint packages --ext .js,.jsx,.ts,.tsx",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/eslint-parser": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "eslint": "^8.56.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "jest": "^29.7.0",
    "babel-jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "transform": {
      "^.+\\.jsx?$": "babel-jest"
    }
  },
  "keywords": [
    "accessibility",
    "a11y",
    "ГОСТ",
    "доступность",
    "React",
    "ESLint"
  ],
  "author": "biondohod",
  "license": "MIT"
}

